{
    "name": "xoditor",
    "version": "1.0.0",
    "description": "A lightweight rich text editor",
    "main": "dist/xoditor.min.js",
    "module": "src/index.mjs",
    "files": [
        "dist/",
        "src/",
        "fonts/",
        "vendor/",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "build:site": "npm run build && node scripts/build-site.cjs",
        "build": "node scripts/build-metadata.cjs && node scripts/build-code-tools.cjs && npm run minify-js && npm run minify-css",
        "minify-js": "terser vendor/codemirror.min.js vendor/prettier-html.min.js src/xoditor.js src/xoditor-enhancements.js -o dist/xoditor.min.js -c -m --comments '/^!/' && node scripts/release-banner.cjs",
        "minify-css": "cleancss -o dist/xoditor.min.css vendor/codemirror.css src/xoditor.css src/xoditor-enhancements.css && node scripts/release-banner.cjs css",
        "test": "node tests/browser.test.cjs",
        "test:modules": "node tests/extensions.test.mjs && node tests/module-browser.cjs",
        "test:all": "node tests/run-matrix.cjs",
        "test:dist": "node tests/run-matrix.cjs --dist",
        "check": "node scripts/check.cjs",
        "verify": "npm run build:site && npm run check && npm run test:all && npm run test:document && npm run test:a11y",
        "deploy:gwp": "npm run build && node scripts/deploy-gwp.cjs",
        "check:deployed": "node scripts/check.cjs --deployed",
        "test:document": "node tests/document-regression.cjs",
        "test:a11y": "node tests/accessibility.cjs",
        "test:office-benchmark": "node tests/office-benchmark.cjs"
    },
    "keywords": [
        "editor",
        "wysiwyg",
        "rich-text",
        "contenteditable",
        "cdn"
    ],
    "author": "Ramesh Maharjan (https://rameshmaharjan.info.np)",
    "homepage": "https://xoditor.rameshmaharjan.info.np",
    "license": "MIT",
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "clean-css-cli": "^5.0.0",
        "playwright": "1.58.2",
        "terser": "^5.0.0"
    },
    "cdn": {
        "js": "dist/xoditor.min.js",
        "css": "dist/xoditor.min.css"
    },
    "dependencies": {
        "codemirror": "5.65.21",
        "prettier": "3.8.3"
    }
}
