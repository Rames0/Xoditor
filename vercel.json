{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci --include=dev",
    "buildCommand": "npm run build:site",
    "outputDirectory": "public",
    "headers": [
        {
            "source": "/LICENSE",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                },
                {
                    "key": "Content-Disposition",
                    "value": "inline"
                }
            ]
        },
        {
            "source": "/dist/:file*",
            "headers": [
                {
                    "key": "Content-Disposition",
                    "value": "inline"
                }
            ]
        }
    ]
}
